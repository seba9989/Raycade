# Uruchamiaj z katalogu głównego projektu: doxygen doxygen/Doxyfile
PROJECT_NAME           = "Raycade"
PROJECT_BRIEF          = "Silnik 2D na raylib z kaskadowym API"
OUTPUT_LANGUAGE        = Polish
OUTPUT_DIRECTORY       = doxygen

INPUT                  = engine demo KONWENCJE.md
# nagłówek zbiorczy "raycade" nie ma rozszerzenia
EXTENSION_MAPPING      = no_extension=C++
FILE_PATTERNS          = *.hpp *.cpp raycade
RECURSIVE              = YES
STRIP_FROM_PATH        = engine/umbrella engine/include engine/src demo
# w dokumentacji klas pokazuj #include <raycade/...>, tak jak dołącza je gra
STRIP_FROM_INC_PATH    = engine/umbrella engine/include
FULL_PATH_NAMES        = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES

# Motyw doxygen-awesome-css v2.5.0 (licencja MIT), wariant z samym panelem bocznym:
# https://github.com/jothepro/doxygen-awesome-css
# Tryb ciemny włącza się automatycznie według ustawień systemu.
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_EXTRA_STYLESHEET  = doxygen/doxygen-awesome-css/doxygen-awesome.css \
                         doxygen/doxygen-awesome-css/doxygen-awesome-sidebar-only.css
HTML_COLORSTYLE        = LIGHT

GENERATE_LATEX         = NO
GENERATE_XML           = NO
HAVE_DOT               = NO

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES
